# --- Dependências ---
node_modules/

# --- Build (só `dist/` vai para Netlify; nunca versionar output) ---
dist/
build/
*.tsbuildinfo

# --- FFmpeg (copiado por scripts/copy-ffmpeg-core.mjs em postinstall/prebuild) ---
public/ffmpeg/

# --- Secrets e env local (manter apenas templates versionados) ---
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# --- Caches de ferramentas ---
.vite/
.cache/
.eslintcache
.turbo/
.parcel-cache/

# --- Cloudflare Worker / Netlify (estado local, não prod) ---
.wrangler/
.mf/
.netlify/

# --- Testes / cobertura ---
coverage/

# --- Logs e debug ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- SO ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE / editor (config local por máquina) ---
.idea/
.vscode/
!.vscode/extensions.json
.cursor/
*.swp
*.swo
*~

# --- Credenciais acidentais ---
*.pem
*.key
*.p12
*.pfx

# --- Temporários ---
tmp/
temp/
*.tmp

# --- Só desenvolvimento / referência local (não faz parte do deploy) ---
docs/
pb_schema/
scripts/

# --- Worker (espelha root) ---
worker/node_modules/
worker/dist/
